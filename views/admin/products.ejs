<%- include('../partials/header', {title}) %><div class="admin-shell"><%- include('../partials/admin-nav') %><div class="admin-content"><div class="admin-topbar"><div><span class="section-kicker">CATALOG / COMMERCE</span><h1>محصولات، دوره‌ها و پلاگین‌ها</h1><p>قیمت و وضعیت انتشار را کنترل کنید و از صفحهٔ ویرایش، فایل‌ها و سرفصل‌ها را اضافه کنید.</p></div><a href="/admin/products/new" class="button button-primary">＋ محصول جدید</a></div><section class="admin-panel"><div class="table-responsive"><table class="data-table"><thead><tr><th>محصول</th><th>نوع</th><th>قیمت</th><th>محتوا</th><th>وضعیت</th><th></th></tr></thead><tbody><% products.forEach(p=>{ %><tr><td><div class="table-product"><span class="table-product-image"><% if(p.cover_image){ %><img src="<%= p.cover_image %>" alt=""><% }else{ %><b>N</b><% } %></span><span><b><%= p.title %></b><small class="table-sub">/<%= p.slug %></small></span></div></td><td><%= p.product_type==='course'?'دوره آموزشی':'افزونه اتوکد' %></td><td><%= money(p.price_toman) %></td><td><%= p.asset_count %> مورد</td><td><span class="status-pill status-<%= p.status %>"><%= p.status==='published'?'منتشرشده':p.status==='draft'?'پیش‌نویس':'آرشیو' %></span></td><td><div class="row-actions"><a href="/admin/products/<%= p.id %>/edit">ویرایش</a><form action="/admin/products/<%= p.id %>/delete" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button-link danger-text" type="submit" data-confirm="این محصول به آرشیو منتقل شود؟">آرشیو</button></form></div></td></tr><% }) %><% if(!products.length){ %><tr><td colspan="6" class="table-empty">هنوز محصولی ساخته نشده است.</td></tr><% } %></tbody></table></div></section></div></div><%- include('../partials/footer') %>
