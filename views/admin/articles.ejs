<%- include('../partials/header', {title}) %><div class="admin-shell"><%- include('../partials/admin-nav') %><div class="admin-content"><div class="admin-topbar"><div><span class="section-kicker">EDITORIAL / CMS</span><h1>مقالات و مجله</h1><p>مقاله‌ها، تصویر شاخص، متن و وضعیت انتشار از همین پنل کنترل می‌شوند.</p></div><a href="/admin/articles/new" class="button button-primary">＋ مقاله جدید</a></div><section class="admin-panel"><div class="table-responsive"><table class="data-table"><thead><tr><th>عنوان مقاله</th><th>دسته</th><th>تصویر</th><th>وضعیت</th><th>آخرین تغییر</th><th></th></tr></thead><tbody><% articles.forEach(a=>{ %><tr><td><div class="table-product"><span class="table-product-image"><% if(a.cover_image){ %><img src="<%= a.cover_image %>" alt=""><% }else{ %><b>N</b><% } %></span><span><b><%= a.title %></b><small class="table-sub">/<%= a.slug %></small></span></div></td><td><%= a.category %></td><td><%= a.cover_image?'دارد':'ندارد' %></td><td><span class="status-pill status-<%= a.status %>"><%= a.status==='published'?'منتشرشده':a.status==='draft'?'پیش‌نویس':'آرشیو' %></span></td><td><%= new Date(a.updated_at).toLocaleDateString('fa-IR') %></td><td><div class="row-actions"><a href="/admin/articles/<%= a.id %>/edit">ویرایش</a><form action="/admin/articles/<%= a.id %>/delete" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button-link danger-text" type="submit" data-confirm="این مقاله به آرشیو منتقل شود؟">آرشیو</button></form></div></td></tr><% }) %><% if(!articles.length){ %><tr><td colspan="6" class="table-empty">هنوز مقاله‌ای ثبت نشده است.</td></tr><% } %></tbody></table></div></section></div></div><%- include('../partials/footer') %>
