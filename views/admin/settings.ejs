<%- include('../partials/header', {title}) %><div class="admin-shell"><%- include('../partials/admin-nav') %><div class="admin-content"><div class="admin-topbar"><div><span class="section-kicker">SITE CONFIGURATION</span><h1>تنظیمات عمومی سایت</h1><p>نام، پیام معرفی، راه‌های ارتباطی و متن درباره ما را بدون تغییر کد مدیریت کنید.</p></div></div><form class="admin-panel admin-form" action="/admin/settings" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="form-grid"><div class="form-field"><label for="site_name">نام وب‌سایت</label><input class="form-control" id="site_name" name="site_name" value="<%= settings.site_name || 'Nogiti' %>"></div><div class="form-field"><label for="site_tagline">شعار کوتاه</label><input class="form-control" id="site_tagline" name="site_tagline" value="<%= settings.site_tagline || '' %>"></div><div class="form-field"><label for="contact_email">ایمیل پشتیبانی</label><input class="form-control" id="contact_email" name="contact_email" type="email" value="<%= settings.contact_email || '' %>"></div><div class="form-field"><label for="contact_phone">تلفن تماس</label><input class="form-control" id="contact_phone" name="contact_phone" value="<%= settings.contact_phone || '' %>"></div><div class="form-field"><label for="instagram">شناسه اینستاگرام</label><input class="form-control" id="instagram" name="instagram" value="<%= settings.instagram || '' %>"></div><div class="form-field form-span-2"><label for="about_text">متن درباره ما</label><textarea class="form-control" id="about_text" name="about_text" rows="6"><%= settings.about_text || '' %></textarea></div></div><div class="form-actions"><button class="button button-primary" type="submit">ذخیره تنظیمات</button></div></form></div></div><%- include('../partials/footer') %>
