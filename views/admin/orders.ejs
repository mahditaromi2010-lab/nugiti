<%- include('../partials/header', {title}) %><div class="admin-shell"><%- include('../partials/admin-nav') %><div class="admin-content"><div class="admin-topbar"><div><span class="section-kicker">COMMERCE / ORDERS</span><h1>سفارش‌ها و پرداخت‌ها</h1><p>وضعیت پرداخت تنها پس از بررسی پاسخ درگاه در سمت سرور نهایی می‌شود.</p></div></div><section class="admin-panel"><div class="table-responsive"><table class="data-table"><thead><tr><th>سفارش</th><th>خریدار</th><th>محصول</th><th>مبلغ</th><th>وضعیت</th><th>کد پیگیری</th><th>تاریخ</th></tr></thead><tbody><% orders.forEach(o=>{ %><tr><td>#<%= o.id %></td><td><b><%= (o.first_name+' '+o.last_name).trim() || 'کاربر' %></b><small class="table-sub"><%= o.phone %></small></td><td><%= o.items || '—' %></td><td><%= money(o.total_toman) %></td><td><span class="status-pill status-<%= o.status %>"><%= o.status==='paid'?'موفق':o.status==='pending'?'در انتظار':o.status==='failed'?'ناموفق':'لغو شده' %></span></td><td><%= o.ref_id || '—' %></td><td><%= new Date(o.created_at).toLocaleDateString('fa-IR') %></td></tr><% }) %><% if(!orders.length){ %><tr><td colspan="7" class="table-empty">سفارشی وجود ندارد.</td></tr><% } %></tbody></table></div></section></div></div><%- include('../partials/footer') %>
