<%- include('../partials/header', {title}) %><div class="admin-shell"><%- include('../partials/admin-nav') %><div class="admin-content"><div class="admin-topbar"><div><span class="section-kicker">OVERVIEW / Nogiti</span><h1>نمای کلی سایت</h1><p>وضعیت محتوا، کاربران و سفارش‌های اخیر.</p></div><a href="/" class="button button-outline button-small">مشاهده سایت ↗</a></div><div class="admin-stats"><div class="stat-card"><span>کاربران</span><b><%= stats[0] %></b><small>حساب‌های فعال و عادی</small><span class="stat-icon">♙</span></div><div class="stat-card"><span>محصولات منتشرشده</span><b><%= stats[1] %></b><small>دوره‌ها و پلاگین‌ها</small><span class="stat-icon">▤</span></div><div class="stat-card"><span>مقالات منتشرشده</span><b><%= stats[2] %></b><small>محتوای قابل مشاهده</small><span class="stat-icon">▧</span></div><div class="stat-card"><span>پرداخت‌های موفق</span><b><%= stats[3] %></b><small>سفارش تأییدشده</small><span class="stat-icon">✓</span></div></div><div class="admin-revenue-row"><div class="revenue-card"><div><span class="section-kicker">TOTAL VERIFIED SALES</span><h2>مجموع فروش تأییدشده</h2><p>فقط سفارش‌هایی که پرداختشان در سرور تأیید شده است.</p></div><strong><%= money(stats[4]) %></strong></div><div class="quick-actions"><h3>دسترسی سریع</h3><a href="/admin/products/new">＋ افزودن محصول جدید</a><a href="/admin/articles/new">＋ نوشتن مقاله</a><a href="/admin/orders">مشاهده سفارش‌ها ←</a></div></div><section class="admin-panel"><div class="admin-panel-head"><div><h2>آخرین سفارش‌ها</h2><p>وضعیت پرداخت و خریدار</p></div><a class="text-link" href="/admin/orders">همه سفارش‌ها ←</a></div><div class="table-responsive"><table class="data-table"><thead><tr><th>سفارش</th><th>خریدار</th><th>تاریخ</th><th>مبلغ</th><th>وضعیت</th></tr></thead><tbody><% orders.forEach(o=>{ %><tr><td>#<%= o.id %></td><td><%= (o.first_name+' '+o.last_name).trim() || o.phone %><small class="table-sub"><%= o.phone %></small></td><td><%= new Date(o.created_at).toLocaleDateString('fa-IR') %></td><td><%= money(o.total_toman) %></td><td><span class="status-pill status-<%= o.status %>"><%= o.status==='paid'?'موفق':o.status==='pending'?'در انتظار':o.status==='failed'?'ناموفق':'لغو شده' %></span></td></tr><% }) %><% if(!orders.length){ %><tr><td colspan="5" class="table-empty">هنوز سفارشی ثبت نشده است.</td></tr><% } %></tbody></table></div></section></div></div><%- include('../partials/footer') %>
