<%- include('../partials/header', {title}) %><div class="admin-shell"><%- include('../partials/admin-nav') %><div class="admin-content"><div class="admin-topbar"><div><span class="section-kicker">CUSTOMER MANAGEMENT</span><h1>کاربران</h1><p>مشاهده اطلاعات پایه و کنترل دسترسی حساب‌های کاربری.</p></div></div><section class="admin-panel"><div class="table-responsive"><table class="data-table"><thead><tr><th>کاربر</th><th>موبایل</th><th>شاخه / رشته</th><th>سفارش موفق</th><th>وضعیت</th><th></th></tr></thead><tbody><% users.forEach(u=>{ %><tr><td><b><%= (u.first_name+' '+u.last_name).trim() || 'نامشخص' %></b><small class="table-sub">عضویت: <%= new Date(u.created_at).toLocaleDateString('fa-IR') %></small></td><td><%= u.phone %></td><td><%= [u.branch,u.field].filter(Boolean).join(' / ') || '—' %></td><td><%= u.paid_orders %></td><td><span class="status-pill <%= u.is_active?'status-published':'status-archived' %>"><%= u.is_active?'فعال':'غیرفعال' %></span></td><td><form action="/admin/users/<%= u.id %>/toggle" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button-link <%= u.is_active?'danger-text':'' %>" type="submit" data-confirm="وضعیت دسترسی این کاربر تغییر کند؟"><%= u.is_active?'غیرفعال‌سازی':'فعال‌سازی' %></button></form></td></tr><% }) %><% if(!users.length){ %><tr><td colspan="6" class="table-empty">کاربری وجود ندارد.</td></tr><% } %></tbody></table></div></section></div></div><%- include('../partials/footer') %>
